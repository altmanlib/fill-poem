# Server
APP_HOST=0.0.0.0
APP_PORT=17073
DATABASE_URL=postgres://postgres:secret@127.0.0.1:11004/fillpoem?sslmode=disable

# Comma-separated CIDRs / IPs whose X-Forwarded-For is trusted (reverse proxy); empty = use the socket peer
# TRUSTED_PROXIES=127.0.0.1/32

# Exact-match CORS allow list; empty = no CORS headers (same-origin behind a proxy). `*` is rejected
# CORS_ALLOWED_ORIGINS=https://example.com

# Per-client-IP rate limit on /api/v1: sustained requests per second and burst size
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=40

# Tests use the compose db's fillpoem_test database; override only to point elsewhere
# TEST_DATABASE_URL=postgres://postgres:secret@127.0.0.1:11004/fillpoem_test?sslmode=disable

# Host-only keys used by make docker-* / compose image coords
# CR_REGISTRY=
# CR_NAMESPACE=
# CR_USERNAME=
# CR_PASSWORD=

# Image tag the compose `api` service runs
# APP_IMAGE=fill-poem-api:0.1.0
