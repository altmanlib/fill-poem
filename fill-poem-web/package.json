{
  "name": "fill-poem-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 17327",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host --port 17327",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "animejs": "^4.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tsconfig/recommended": "^1.0.13",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
