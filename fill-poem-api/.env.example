# Server
APP_HOST=0.0.0.0
APP_PORT=17073
DATABASE_URL=postgres://postgres:secret@127.0.0.1:11004/fillpoem?sslmode=disable

# Auth
SESSION_SECRET=change-me-change-me-change-me-change-me
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
# Keep the single quotes; otherwise Docker Compose / Make / godotenv eat $UPPERCASE fragments
ADMIN_PASSWORD_HASH=
# TRUSTED_PROXIES=127.0.0.1/32

# Auth behaviour
# SESSION_TTL=168h
# ADMIN_SESSION_TTL=12h
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW=15m

# Host-only keys used by make docker-* / compose image coords
# CR_REGISTRY=
# CR_NAMESPACE=
# CR_USERNAME=
# CR_PASSWORD=

# Image tag the compose `api` service runs
# APP_IMAGE=fill-poem-api:0.1.0
